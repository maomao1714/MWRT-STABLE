CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_huasifei_wh3000-pro=y

#
# Kernel / Build
#
# CONFIG_TESTING_KERNEL is not set
CONFIG_CCACHE=y

CONFIG_TARGET_ROOTFS_PARTSIZE=448
CONFIG_TARGET_ROOTFS_SQUASHFS=y

CONFIG_IPV6=y

#
# ============================================================
# LuCI
# ============================================================
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-light=y

#
# Design 主题
#
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-app-design-config=y

CONFIG_LUCI_LANG_zh_Hans=y

#
# ============================================================
# WiFi - MT7981 / WH3000 Pro
# ============================================================
#

# ★ 关键：补齐 WiFi Scripts
CONFIG_PACKAGE_wifi-scripts=y

# mac80211 / cfg80211
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y

# mt76
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt7915e=y

# MT7981 firmware
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y

# WiFi regulatory / iwinfo
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# WPA
CONFIG_PACKAGE_wpad-openssl-mbedtls=y

#
# ============================================================
# Docker
# ============================================================
#
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y

CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd-compose=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_USER_NS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_NET_NS=y

#
# ============================================================
# OpenVPN
# ============================================================
#
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-i18n-openvpn-server-zh-cn=y
CONFIG_PACKAGE_openvpn-openssl=y

CONFIG_OPENVPN_openssl_ENABLE_LZO=y
CONFIG_OPENVPN_openssl_ENABLE_LZ4=y
CONFIG_OPENVPN_openssl_ENABLE_FRAGMENT=y
CONFIG_OPENVPN_openssl_ENABLE_MULTIHOME=y
CONFIG_OPENVPN_openssl_ENABLE_SMALL=y

CONFIG_PACKAGE_openvpn-easy-rsa=y

#
# ============================================================
# QModem Next
# ============================================================
#

CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_sms-forwarder-next=y
CONFIG_PACKAGE_quectel-CM-5G-M=y

#
# 明确关闭旧版 QModem
#
# CONFIG_PACKAGE_luci-app-qmodem is not set
# CONFIG_PACKAGE_luci-app-qmodem-sms is not set
# CONFIG_PACKAGE_luci-app-qmodem-ttl is not set

#
# 关闭旧版 QModem 中文语言包
#
# CONFIG_PACKAGE_luci-i18n-qmodem-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-qmodem-sms-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-qmodem-ttl-zh-cn is not set

#
# SIP / VOIP 默认关闭
#
# CONFIG_PACKAGE_qmodem-sipd is not set
# CONFIG_PACKAGE_qmodem-voip is not set

#
# ============================================================
# USB WWAN
# ============================================================
#
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y

CONFIG_PACKAGE_kmod-usb-wdm=y

#
# QMI
#
CONFIG_PACKAGE_kmod-qmi_wwan_f=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_kmod-qmi_wwan_s=y

#
# ============================================================
# Lucky
# ============================================================
#
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y

#
# ============================================================
# IPTV
# ============================================================
#
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-iptv-manager=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-unicast-proxy=y

#
# ============================================================
# Samba
# ============================================================
#
CONFIG_PACKAGE_luci-app-samba=y
CONFIG_PACKAGE_samba36-server=y

#
# ============================================================
# USB Storage
# ============================================================
#
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

#
# ============================================================
# Filesystem
# ============================================================
#
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y

#
# ============================================================
# Network Optimization
# ============================================================
#
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y
CONFIG_PACKAGE_kmod-ipt-offload=y

#
# ============================================================
# Turbo ACC
# ============================================================
#
CONFIG_PACKAGE_luci-app-turboacc=y

#
# ============================================================
# UPnP
# ============================================================
#
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y

#
# ============================================================
# WOL
# ============================================================
#
CONFIG_PACKAGE_wol=y
CONFIG_PACKAGE_luci-app-wol=y

#
# ============================================================
# Common Tools
# ============================================================
#
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssl-util=y

#
# ============================================================
# Network Tools
# ============================================================
#
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

#
# ============================================================
# DNS
# ============================================================
#
CONFIG_PACKAGE_dnsmasq-full=y

#
# ============================================================
# Chinese Language
# ============================================================
#
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

#
# ============================================================
# BusyBox
# ============================================================
#
CONFIG_BUSYBOX_CUSTOM=y

#
# ============================================================
# Performance
# ============================================================
#
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_kmod-sched-core=y

#
# ============================================================
# SSR Plus+
# ============================================================
#
CONFIG_PACKAGE_luci-app-ssr-plus=y

#
# ============================================================
# OpenClash
# ============================================================
#
CONFIG_PACKAGE_luci-app-openclash=y

#
# ============================================================
# VLMCS
# ============================================================
#
CONFIG_PACKAGE_luci-app-vlmcsd=y

#
# ============================================================
# Songloft
# ============================================================
#
CONFIG_PACKAGE_songloft=y
CONFIG_PACKAGE_luci-app-songloft=y

#
# ============================================================
# WebDAV
# ============================================================
#
# CONFIG_PACKAGE_luci-app-webdav is not set
# CONFIG_PACKAGE_nginx-mod-dav-ext is not set

#
# ============================================================
# Crypto
# ============================================================
#
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y

#
# ============================================================
# OpenVPN DCO
# ============================================================
#
# CONFIG_PACKAGE_kmod-ovpn-dco is not set
# CONFIG_PACKAGE_kmod-ovpn-dco-v2 is not set
# CONFIG_PACKAGE_kmod-ovpn-backports is not set
# CONFIG_OPENVPN_openssl_ENABLE_DCO is not set

CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
